{
  "manifest_version": 2,
  "name": "X Thread Clean Capture",
  "version": "1.0.10",
  "description": "Capture a clean image of an X/Twitter thread without surrounding UI.",
  "browser_action": {
    "default_title": "Capture clean X thread"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://pbs.twimg.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://x.com/*",
        "https://www.x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "capture.html",
    "capture.js",
    "capture.css"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-thread-clean-capture@szyi.local",
      "strict_min_version": "109.0"
    }
  }
}
